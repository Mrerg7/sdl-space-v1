---
import { ACQUISITION_MAILTO, OG_IMAGE } from '../config/site';
---

<header class="relative min-h-[min(100svh,720px)] md:min-h-[680px] flex items-center overflow-hidden bg-slate-900">
  <div class="absolute inset-0">
    <img
      src={OG_IMAGE}
      alt="Scottsdale desert landscape — premium space for storage, events, and land"
      class="w-full h-full object-cover object-center scale-105"
      width="1920"
      height="1080"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <!-- Left-weighted scrim for text legibility; right side stays visible -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/75 via-slate-950/40 to-slate-950/10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-slate-950/15"></div>
  </div>

  <div class="relative w-full max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-0">
    <div class="max-w-3xl">
      <div
        class="inline-flex items-center gap-x-2 bg-white/10 backdrop-blur-md border border-white/20 px-3 sm:px-4 py-1.5 rounded-3xl mb-6 sm:mb-8 max-w-full"
      >
        <div class="w-1.5 h-1.5 shrink-0 bg-emerald-400 rounded-full animate-pulse"></div>
        <span class="text-[10px] sm:text-xs font-semibold tracking-[1px] sm:tracking-[1.5px] text-white/90"
          >PREMIUM .SPACE DOMAIN • SCOTTSDALE, AZ</span
        >
      </div>

      <h1 class="text-white">
        <span class="block font-bold tracking-tighter domain-name font-display">sdl.space</span>
      </h1>

      <p class="mt-4 max-w-xl text-lg sm:text-xl md:text-2xl text-white/90 tracking-tight leading-snug">
        The premier domain for storage, event spaces, and open land acquisition in Scottsdale, Arizona.
      </p>

      <div class="mt-8 sm:mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href={ACQUISITION_MAILTO}
          class="w-full sm:w-auto text-center px-8 sm:px-10 py-3.5 sm:py-4 bg-white text-slate-900 hover:bg-amber-50 font-semibold rounded-3xl text-base transition-all active:scale-[0.985] shadow-xl"
        >
          Inquire to Purchase
        </a>
        <a
          href="#market"
          class="w-full sm:w-auto text-center px-6 sm:px-8 py-3.5 sm:py-4 border border-white/30 hover:bg-white/10 text-white font-semibold rounded-3xl text-base transition-all"
        >
          <span class="sm:hidden">Explore Market</span>
          <span class="hidden sm:inline">Explore the Scottsdale Space Market</span>
        </a>
      </div>

      <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-x-6 text-xs text-white/60">
        <div>Short • Versatile • Market-Owning</div>
        <div class="hidden sm:block w-px h-3 bg-white/30"></div>
        <div>Storage • Events • Land Acquisition</div>
      </div>
    </div>
  </div>
</header>
