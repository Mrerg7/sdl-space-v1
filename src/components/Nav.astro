---
import { ACQUISITION_MAILTO } from '../config/site';
---

<nav class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50" aria-label="Primary">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-16 sm:h-20 gap-3">
      <a href="#top" class="flex items-center gap-x-2 sm:gap-x-3 min-w-0 min-h-[48px]" aria-label="sdl.space home">
        <div class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 bg-slate-900 rounded-2xl flex items-center justify-center">
          <span class="text-white font-bold text-base sm:text-xl tracking-tighter">SDL</span>
        </div>
        <div class="font-semibold text-lg sm:text-xl tracking-tighter text-slate-900 truncate">
          sdl<span class="text-amber-700">.</span>space
        </div>
      </a>

      <div class="hidden md:flex items-center gap-x-8 text-sm font-medium">
        <a href="#why" class="nav-link min-h-[48px] inline-flex items-center">Why This Domain</a>
        <a href="#perfect-for" class="nav-link min-h-[48px] inline-flex items-center">Perfect For</a>
        <a href="#market" class="nav-link min-h-[48px] inline-flex items-center">Scottsdale Space Market</a>
        <a href="#faq" class="nav-link min-h-[48px] inline-flex items-center">FAQ</a>
        <a href="#acquire" class="nav-link min-h-[48px] inline-flex items-center">Acquire</a>
      </div>

      <div class="flex items-center gap-x-3">
        <a
          href="https://sdl.contact"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center text-xs px-4 py-2 border border-slate-300 hover:bg-slate-100 rounded-3xl font-medium text-slate-600 transition-colors"
        >
          SDL Portfolio
        </a>
        <a
          href={ACQUISITION_MAILTO}
          data-cta="nav-make-offer"
          class="shrink-0 inline-flex items-center px-4 sm:px-6 py-2 sm:py-2.5 bg-slate-900 hover:bg-black text-white text-xs sm:text-sm font-semibold rounded-3xl transition-all active:scale-[0.985]"
        >
          <span class="sm:hidden">Offer</span>
          <span class="hidden sm:inline">Make an Offer</span>
        </a>
        {/* Mobile hamburger: 48px tap target, collapsible nav */}
        <button
          id="nav-toggle"
          type="button"
          class="md:hidden inline-flex items-center justify-center w-12 h-12 rounded-2xl border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open navigation menu"
        >
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Collapsible mobile menu — no horizontal scroll, full-width stacked links */}
  <div id="mobile-menu" class="md:hidden hidden border-t border-slate-200 bg-white">
    <div class="px-4 py-3 flex flex-col text-base font-medium">
      <a href="#why" class="mobile-link py-3.5 px-2 min-h-[48px] inline-flex items-center text-slate-700 hover:text-slate-900 border-b border-slate-100">Why This Domain</a>
      <a href="#perfect-for" class="mobile-link py-3.5 px-2 min-h-[48px] inline-flex items-center text-slate-700 hover:text-slate-900 border-b border-slate-100">Perfect For</a>
      <a href="#market" class="mobile-link py-3.5 px-2 min-h-[48px] inline-flex items-center text-slate-700 hover:text-slate-900 border-b border-slate-100">Scottsdale Space Market</a>
      <a href="#faq" class="mobile-link py-3.5 px-2 min-h-[48px] inline-flex items-center text-slate-700 hover:text-slate-900 border-b border-slate-100">FAQ</a>
      <a href="#acquire" class="mobile-link py-3.5 px-2 min-h-[48px] inline-flex items-center text-slate-700 hover:text-slate-900 border-b border-slate-100">Acquire</a>
      <a href="https://sdl.contact" target="_blank" rel="noopener noreferrer" class="mobile-link py-3.5 px-2 min-h-[48px] inline-flex items-center text-amber-700 font-semibold">SDL Portfolio →</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setMenu(open) {
    if (!menu || !toggle || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
  }

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden') ?? true;
    setMenu(isHidden);
  });

  // Close menu on link tap (mobile UX)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
</script>
