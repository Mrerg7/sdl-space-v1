---
/* Trust signals strip: escrow, SSL, guarantees — text badges keep page < 2s (no external images). */
const signals = [
  { title: 'Escrow.com-ready', detail: 'Funds held until transfer completes' },
  { title: 'Secure transfer', detail: 'Direct registrar push, 1–3 days' },
  { title: 'Confidential', detail: 'Private inquiries, 24–48h reply' },
  { title: '1-of-1 asset', detail: 'Exclusive .space exact-match domain' },
];
---

<section class="border-b border-slate-200 bg-white" aria-label="Buyer protections">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-center">
      {
        signals.map((s) => (
          <div class="reveal rounded-2xl border border-slate-100 bg-slate-50 px-3 py-4">
            <dt class="inline-flex items-center justify-center gap-1.5 text-sm font-bold text-slate-900">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.6 2A9 9 0 1112 3a9 9 0 018.6 9z" />
              </svg>
              {s.title}
            </dt>
            <dd class="mt-1 text-xs text-slate-500">{s.detail}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
