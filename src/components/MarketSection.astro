---
import type { CollectionEntry } from 'astro:content';

interface Props {
  marketStats: CollectionEntry<'marketStats'>[];
}

const { marketStats } = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16" id="market">
  <div class="max-w-2xl mb-10">
    <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-700 mb-3">THE MARKET</div>
    <h2 class="text-3xl sm:text-4xl tracking-tighter font-semibold">
      Scottsdale offers strong and diverse demand for versatile space solutions.
    </h2>
    <p class="mt-4 text-slate-600">
      Driven by robust tourism, a growing population, thriving events scene, and ongoing development needs,
      Scottsdale presents excellent opportunities across storage, event venues, and open land acquisition.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      marketStats.map((stat) => (
        <div class="bg-white border border-slate-200 rounded-3xl p-7">
          <div class="text-amber-700 text-xs tracking-widest font-semibold mb-2">{stat.data.label}</div>
          <div class="font-semibold text-lg">{stat.data.title}</div>
          <p class="mt-3 text-sm text-slate-600">{stat.data.description}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-8 text-xs text-slate-500 max-w-3xl">
    Market insights based on Scottsdale's strong tourism (11M+ visitors), population growth, events industry,
    and commercial development trends. Demand for versatile space solutions remains robust.
  </div>
</section>
