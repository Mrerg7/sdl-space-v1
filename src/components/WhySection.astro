---
import type { CollectionEntry } from 'astro:content';

interface Props {
  pillars: CollectionEntry<'pillars'>[];
}

const { pillars } = Astro.props;
---

<div class="border-b border-slate-200 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 sm:py-5">
    <div
      class="flex flex-wrap justify-center md:justify-between items-center gap-x-8 gap-y-3 text-sm text-center md:text-left"
    >
      <div>Scottsdale: Premier destination for versatile commercial & event space</div>
      <div class="hidden md:block text-slate-300">•</div>
      <div>Strong demand for storage, venues & developable land</div>
    </div>
  </div>
</div>

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-12 sm:pt-16 pb-12" id="why">
  <div class="max-w-2xl">
    <div class="uppercase tracking-[2px] text-xs font-semibold text-amber-700 mb-3">THE OPPORTUNITY</div>
    <h2 class="text-3xl sm:text-4xl md:text-5xl tracking-tighter font-semibold font-display">
      Own the definitive domain<br />for Scottsdale space solutions.
    </h2>
    <p class="mt-5 text-lg text-slate-600">
      SDL.Space is short, modern, and perfectly descriptive. It instantly communicates versatility across
      storage, event venues, and open land acquisition in one of Arizona's most dynamic and desirable
      markets. A rare opportunity to own the premium branding for "Scottsdale Space."
    </p>
  </div>

  <div class="mt-12 grid md:grid-cols-3 gap-5">
    {
      pillars.map((pillar) => (
        <div class="value-card bg-white border border-slate-200 rounded-3xl p-7">
          <div class="text-amber-700 text-xs tracking-widest font-semibold mb-3">{pillar.data.label}</div>
          <div class="font-semibold text-xl tracking-tight">{pillar.data.title}</div>
          <p class="mt-3 text-sm text-slate-600">{pillar.data.description}</p>
        </div>
      ))
    }
  </div>
</section>
