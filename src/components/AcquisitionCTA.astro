---
import { ACQUISITION_MAILTO, SITE, DOMAIN_OFFER } from '../config/site';

const buyNowMailto =
  `mailto:${SITE.email}?subject=${encodeURIComponent('sdl.space — Buy Now at $4,995')}` +
  `&body=${encodeURIComponent('Hello,\n\nI would like to purchase sdl.space at the listed price of $4,995 via escrow.\n\nName:\nRegistrar account (for transfer):\n\nThank you.')}`;

const agentMailto =
  `mailto:${SITE.email}?subject=${encodeURIComponent('sdl.space — Talk to an agent')}` +
  `&body=${encodeURIComponent('Hello,\n\nI would like to speak with an agent about sdl.space.\n\nQuestions:\nBest time to reach me:\n\nThank you.')}`;
---

<section class="bg-slate-900 py-12 sm:py-16" id="acquire" aria-labelledby="acquire-heading">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <div class="inline px-4 py-1 rounded-3xl bg-white/10 text-white text-xs tracking-[1.5px] font-medium mb-4">
      SERIOUS INQUIRIES ONLY • {DOMAIN_OFFER.availability.toUpperCase()}
    </div>
    <h2 id="acquire-heading" class="text-white text-3xl sm:text-4xl md:text-5xl tracking-tighter font-semibold font-display">
      Ready to own SDL.Space?
    </h2>
    <p class="mt-4 text-white/70 max-w-md mx-auto">
      Listed at <strong class="text-white">{DOMAIN_OFFER.priceDisplay}</strong> via secure escrow.
      Premium, versatile domains for storage, events, and land are extremely rare — contact us for a
      confidential acquisition discussion.
    </p>

    {/* Tiered CTAs by buyer intent */}
    <div class="mt-10 flex flex-col sm:flex-row items-stretch justify-center gap-3">
      <a
        href={buyNowMailto}
        data-cta="acquire-buy-now"
        class="inline-flex items-center justify-center gap-x-2 px-8 py-4 bg-white text-slate-900 hover:bg-amber-50 font-semibold rounded-3xl text-base transition-all active:scale-[0.985] shadow-xl"
      >
        <span>Buy Now — {DOMAIN_OFFER.priceDisplay}</span>
      </a>
      <a
        href={ACQUISITION_MAILTO}
        data-cta="acquire-make-offer"
        class="inline-flex items-center justify-center px-8 py-4 border border-white/30 hover:bg-white/10 text-white font-semibold rounded-3xl text-base transition-all"
      >
        Make an Offer
      </a>
      <a
        href={agentMailto}
        data-cta="acquire-contact-agent"
        class="inline-flex items-center justify-center px-8 py-4 text-white/80 hover:text-white hover:bg-white/5 font-medium rounded-3xl text-base transition-all underline-offset-4 hover:underline"
      >
        Contact Agent
      </a>
    </div>

    <p class="mt-6 text-sm text-white/50">
      Email <a href={`mailto:${SITE.email}`} class="text-white/80 hover:text-white underline">{SITE.email}</a>
      — we typically respond within 24–48 hours. All inquiries are confidential.
    </p>
    <p class="mt-2 text-xs text-white/40">Escrow-protected • Transfer in 1–3 days • SSL-secure inquiry</p>
  </div>
</section>
