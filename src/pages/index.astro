---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhySection from '../components/WhySection.astro';
import UseCasesSection from '../components/UseCasesSection.astro';
import MarketSection from '../components/MarketSection.astro';
import AcquisitionCTA from '../components/AcquisitionCTA.astro';
import CrossPromo from '../components/CrossPromo.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const sortByOrder = <T extends { data: { order: number } }>(items: T[]) =>
  items.sort((a, b) => a.data.order - b.data.order);

const pillars = sortByOrder(await getCollection('pillars'));
const useCases = sortByOrder(await getCollection('useCases'));
const marketStats = sortByOrder(await getCollection('marketStats'));
---

<BaseLayout>
  <Nav />
  <Hero />
  <WhySection pillars={pillars} />
  <UseCasesSection useCases={useCases} />
  <MarketSection marketStats={marketStats} />
  <AcquisitionCTA />
  <CrossPromo />
  <Footer />
</BaseLayout>
